# ====================================================================
# SOCIAL XI-B2 (SMAN 1 SANDAI) - ENVIRONMENT VARIABLES TEMPLATE
# ====================================================================

# Port & Node Environment (Strict Port 3000 for AI Studio container)
PORT=3000
NODE_ENV=development

# MongoDB Atlas Production Connection
# Format: mongodb+srv://<username>:<password>@<cluster-host>/<database>?retryWrites=true&w=majority
MONGODB_URI=

# Authentication & Security Secrets
JWT_SECRET=
AUTH_SECRET=

# CORS Origin Configuration (Optional)
CORS_ORIGIN=

# Gemini AI API Key (Server-Side Proxy)
GEMINI_API_KEY=

# Application URL
APP_URL=http://localhost:3000

