# ====================================================================
# SOCIAL XI-B2 BACKEND - ENVIRONMENT VARIABLES TEMPLATE
# ====================================================================

# Port & Runtime
PORT=3000
NODE_ENV=development

# MongoDB Atlas Database Connection
# Example: mongodb+srv://<username>:<password>@<cluster-host>/social_xi_b2?retryWrites=true&w=majority
MONGODB_URI=

# Authentication Secrets (minimum 32 characters in production)
JWT_SECRET=
AUTH_SECRET=

# CORS Origin Configuration
CORS_ORIGIN=
